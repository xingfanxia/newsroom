{
  "name": "newsroom",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "code:dead": "bunx knip --include files,dependencies,unlisted,binaries,unresolved,catalog --reporter compact",
    "code:dead:exports": "bunx knip --include exports,nsExports --reporter compact",
    "code:dead:types": "bunx knip --include types,nsTypes --reporter compact",
    "test": "bun test --env-file=.env.local",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push --force",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun scripts/ops/seed-sources.ts",
    "db:ping": "bun scripts/ops/ping-db.ts",
    "db:init-ext": "bun scripts/ops/db-init-extensions.ts",
    "db:hnsw": "bun scripts/ops/db-create-hnsw.ts",
    "cron:hourly": "bun scripts/ops/run-cron.ts hourly",
    "cron:daily": "bun scripts/ops/run-cron.ts daily",
    "cron:weekly": "bun scripts/ops/run-cron.ts weekly",
    "cron:normalize": "bun scripts/ops/run-cron.ts normalize",
    "cron:enrich": "bun scripts/ops/run-cron.ts enrich",
    "cron:body": "bun scripts/ops/run-cron.ts body",
    "cron:yt": "bun scripts/ops/run-cron.ts yt",
    "cron:cluster": "bun scripts/ops/run-cron.ts cluster"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.71",
    "@ai-sdk/azure": "^3.0.54",
    "@ai-sdk/google": "^3.0.64",
    "@ai-sdk/openai": "^3.0.53",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@radix-ui/react-slot": "^1.2.4",
    "ai": "^6.0.167",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.6.0",
    "linkedom": "^0.18.12",
    "lucide-react": "^1.8.0",
    "next": "16.2.4",
    "next-intl": "^4.9.1",
    "p-limit": "^7.3.0",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "youtube-transcript": "^1.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "typescript": "^5"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
