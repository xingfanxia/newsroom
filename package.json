{
  "name": "newsroom",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "verify": "bun scripts/verification/run-hermetic-verify.ts",
    "code:dead": "bunx knip --include files,dependencies,unlisted,binaries,unresolved,catalog --reporter compact",
    "code:dead:exports": "bunx knip --include exports,nsExports --reporter compact",
    "code:dead:types": "bunx knip --include types,nsTypes --reporter compact",
    "test": "bun scripts/verification/run-hermetic-tests.ts",
    "test:production": "bun scripts/verification/run-hermetic-tests.ts --production",
    "test:production:semantic": "bun scripts/verification/run-hermetic-tests.ts --production-semantic",
    "verify:r2-public": "bun scripts/verification/r2-public.ts",
    "verify:public-boundary": "bun scripts/ops/check-public-db-boundary.ts --source --summary && bun scripts/ops/check-public-full-state-boundary.ts && bun scripts/verification/check-public-nft.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "echo 'db:push is DISABLED — drizzle-kit push --force applies a known F32_BLOB false-diff that DROPS items.embedding + the DiskANN index (unrecoverable, no backup). Schema changes go through ordered raw-SQL ops scripts + schema_migrations. See docs/HANDOFF.md § Turso.' && exit 1",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun scripts/ops/seed-sources.ts",
    "db:ping": "bun scripts/ops/ping-db.ts",
    "db:vector-index": "bun scripts/ops/db-create-vector-index.ts",
    "db:add-recheck-column": "bun scripts/ops/add-recheck-column.ts",
    "db:optimize": "bun scripts/ops/db-optimize.ts",
    "cron:fetch-hourly": "bun scripts/ops/run-cron.ts fetch-hourly",
    "cron:fetch-daily": "bun scripts/ops/run-cron.ts fetch-daily",
    "cron:fetch-weekly": "bun scripts/ops/run-cron.ts fetch-weekly",
    "cron:hourly": "bun scripts/ops/run-cron.ts hourly",
    "cron:daily": "bun scripts/ops/run-cron.ts daily",
    "cron:weekly": "bun scripts/ops/run-cron.ts weekly",
    "cron:normalize": "bun scripts/ops/run-cron.ts normalize",
    "cron:article-body": "bun scripts/ops/run-cron.ts article-body",
    "cron:enrich": "bun scripts/ops/run-cron.ts enrich",
    "cron:commentary": "bun scripts/ops/run-cron.ts commentary",
    "cron:score-backfill": "bun scripts/ops/run-cron.ts score-backfill",
    "cron:score": "bun scripts/ops/run-cron.ts score",
    "cron:body": "bun scripts/ops/run-cron.ts body",
    "cron:youtube-transcript": "bun scripts/ops/run-cron.ts youtube-transcript",
    "cron:yt": "bun scripts/ops/run-cron.ts yt",
    "cron:cluster": "bun scripts/ops/run-cron.ts cluster",
    "cron:newsletter-daily": "bun scripts/ops/run-cron.ts newsletter-daily",
    "cron:newsletter-send": "bun scripts/ops/run-cron.ts newsletter-send",
    "cron:newsletter-monthly": "bun scripts/ops/run-cron.ts newsletter-monthly",
    "cron:publish-public": "bun scripts/ops/run-cron.ts publish-public",
    "snapshot:publish": "bun scripts/ops/publish-public-snapshot.ts",
    "snapshot:export-bootstrap": "bun scripts/ops/export-public-bootstrap.ts",
    "snapshot:bootstrap": "bun scripts/ops/bootstrap-public-snapshot.ts",
    "snapshot:reconcile": "bun scripts/ops/reconcile-public-snapshot.ts",
    "evidence:load-public": "bun scripts/ops/load-anonymous.ts",
    "evidence:r2-cache": "bun scripts/ops/verify-r2-cache.ts",
    "evidence:turso-window": "bun scripts/ops/measure-turso-window.ts",
    "evidence:public-cutover": "bun scripts/ops/verify-public-cutover.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.71",
    "@ai-sdk/azure": "^3.0.54",
    "@ai-sdk/google": "^3.0.64",
    "@ai-sdk/openai": "^3.0.53",
    "@aws-sdk/client-s3": "3.1087.0",
    "@libsql/client": "^0.17.4",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@radix-ui/react-slot": "^1.2.4",
    "ai": "^6.0.167",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.6.0",
    "linkedom": "^0.18.12",
    "lucide-react": "^1.8.0",
    "next": "16.2.4",
    "next-intl": "^4.9.1",
    "p-limit": "^7.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "youtube-transcript": "^1.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.10.6",
    "@next/env": "16.2.4",
    "@tailwindcss/postcss": "^4",
    "@types/bun": "^1.3.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "typescript": "^5"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
