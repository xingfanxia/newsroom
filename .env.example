# AX's AI RADAR — environment template. Copy to .env.local and fill in.
# Run `vercel env pull .env.local --yes` to sync locally.

# ─── Turso libSQL (replaced Supabase Postgres, 2026-07-11) ───
# Create a DB + mint a token via the Turso dashboard or Platform API
# (api.turso.tech). Same values go in all Vercel environments.
TURSO_DATABASE_URL=libsql://<db-name>-<org>.turso.io
TURSO_AUTH_TOKEN=

# ─── Cloudflare R2 public snapshots ───
# Anonymous readers need only the public custom-domain URL. Publisher credentials
# belong in server/Vercel environments only; never expose them to NEXT_PUBLIC_*.
R2_PUBLIC_BASE_URL=https://content.ax0x.ai
R2_BUCKET=newsroom-public
R2_ACCOUNT_ID=
# Optional explicit S3 endpoint; otherwise R2_ACCOUNT_ID derives it.
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Production evidence is intentionally not enabled here. Operators set
# RUN_PRODUCTION_INTEGRATION=1 and R2_PUBLIC_EVIDENCE_MANIFEST only for an
# approved, named, bounded evidence window; see docs/operations/public-snapshots.md.

# ─── Azure OpenAI — embeddings resource (text-embedding-3-large) ───
# This resource is the legacy /openai/deployments/<name> chat-completions +
# embeddings endpoint. Chat traffic now lives on the CHAT resource below; this
# pair is kept for embeddings only.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
# Legacy chat deployment metadata; active workers do not use this pair.
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_MODEL=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# ─── Azure OpenAI — chat compatibility/probe resource ───
# AI Foundry URL — may be either /openai/v1 or /openai/v1/responses.
# The LLM client strips a trailing /responses before passing baseURL to the SDK.
# Active prose/scoring workers use Azure DeepSeek by default; choose this
# provider only for an intentional AIHOT_*_PROVIDER override or probe script.
AZURE_OPENAI_CHAT_API_KEY=
AZURE_OPENAI_CHAT_ENDPOINT=https://<your-resource>.services.ai.azure.com/openai/v1/responses
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5.5-standard

# ─── Azure AI Foundry — DeepSeek primary prose/scoring ───
# Uses the same OpenAI-compatible Responses endpoint shape as CHAT.
AZURE_DEEPSEEK_API_KEY=
AZURE_DEEPSEEK_ENDPOINT=https://<your-resource>.services.ai.azure.com/openai/v1/responses
AZURE_DEEPSEEK_DEPLOYMENT=DeepSeek-V4-Pro
AZURE_DEEPSEEK_FLASH_DEPLOYMENT=DeepSeek-V4-Flash

# ─── Azure OpenAI — PRO resource (reserved for M4 agent loop) ───
# Separate Azure resource with OpenAI-compat /v1/ endpoint. Only used when
# AIHOT_SCORE_PROVIDER or the M4 agent explicitly requests the "pro" provider.
AZURE_OPENAI_PRO_API_KEY=
AZURE_OPENAI_PRO_ENDPOINT=https://<your-resource>.openai.azure.com/openai/v1/
AZURE_OPENAI_PRO_DEPLOYMENT=

# ─── Optional fallback providers (not called by M2 workers) ───
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-pro-preview

# ─── RSSHub mirror (optional) ───
# The free rsshub.app instance rate-limits / 403s heavily on Vercel IPs.
# Set this to a self-hosted or community mirror (e.g. https://rsshub.rssforever.com)
# to override the base for all sources where kind="rsshub". Leave blank to keep rsshub.app.
RSSHUB_BASE_URL=

# ─── Task routing (which provider handles which workload) ───
# allowed: anthropic | gemini | azure-openai | azure-openai-pro | azure-deepseek
AIHOT_ENRICH_PROVIDER=azure-deepseek
AIHOT_SCORE_PROVIDER=azure-deepseek
AIHOT_EMBED_PROVIDER=azure-openai
# Optional per-call timeout for generate/embed calls. Defaults to 90000.
# LLM_CALL_TIMEOUT_MS=90000

# ─── AI HOT (https://aihot.virxact.com) external API client ───
# Source ingest pulls hourly from AI HOT's mode=selected pool.
# Daily column generator uses their structured /daily report as a must-cover
# baseline. Both have safe defaults — set these only if overriding base URL
# (e.g. mirror) or User-Agent (default browser-ish UA passes their bot check).
# NB: AIHOT_API_* (with the API_ infix) — NOT to be confused with the
# internal AIHOT_*_PROVIDER routing keys above.
# AIHOT_API_BASE_URL=https://aihot.virxact.com
# AIHOT_API_USER_AGENT=
